# Variables de entorno de MG Nutrición y Entrenamiento (CA-00.2.3).
# Copiar a .env (no versionado) o cargar como App Settings en Azure. Ningún secreto real debe subirse al repositorio.

# --- Perfil (local | dev | prod) y opcionalmente demo: local,demo
SPRING_PROFILES_ACTIVE=local
PORT=8090

# --- Base de datos (usuario de la aplicación: db_datareader, db_datawriter, EXECUTE y rol mgnutri_app)
DB_URL=jdbc:sqlserver://localhost:14333;databaseName=mgnutri;encrypt=true;trustServerCertificate=true
DB_USER=sa
DB_PASSWORD=
DB_SA_PASSWORD=
# Usuario propietario del esquema para Flyway (en Azure distinto del de la aplicación)
SPRING_FLYWAY_URL=
SPRING_FLYWAY_USER=
SPRING_FLYWAY_PASSWORD=

# --- Seguridad
JWT_SECRET=            # Base64 de al menos 32 bytes aleatorios:  openssl rand -base64 48
DATA_KEY_BASE64=       # Base64 de exactamente 32 bytes (AES-256): openssl rand -base64 32
ADMIN_USERNAME=admin
ADMIN_PASSWORD_INICIAL=  # contraseña temporal del administrador inicial (se exige cambiarla)
FRONTEND_URL=http://localhost:8090
RATE_LIMIT_AUTH=10

# --- WhatsApp Cloud API (Meta)
WA_ENABLED=false
WA_PHONE_ID=
WA_TOKEN=
WA_API_VERSION=v25.0
WA_CREDENCIALES_MODO=PASSWORD   # PASSWORD (solo local) | ENLACE (Meta no aprueba la plantilla con contraseña)

# --- Jobs programados
JOBS_ENABLED=true

# --- Backups (local | azure)
BACKUP_PROVIDER=local
BACKUP_DIR_SERVIDOR=/var/opt/mssql/backup
BACKUP_DIR_DESCARGA=
BACKUP_DB_NAME=mgnutri
AZ_SUBSCRIPTION_ID=
AZ_RESOURCE_GROUP=rg-mgnutri
AZ_SQL_SERVER=
AZ_SQL_DATABASE=mgnutri
AZ_SQL_ADMIN_USER=
AZ_SQL_ADMIN_PASSWORD=
AZ_STORAGE_ACCOUNT=
AZ_STORAGE_KEY=
AZ_STORAGE_CONTAINER=backups

# --- Frontend servido por el backend (local/demo). En Azure el frontend va a Static Web Apps.
FRONTEND_PATH=../frontend
SWAGGER_ENABLED=false
DEMO_PASSWORD=Demo2025!
DEMO_PACIENTES=30      # dataset demo; la prueba de rendimiento usa 500
DEMO_MESES=6           # meses de historia del dataset demo; rendimiento: 12
