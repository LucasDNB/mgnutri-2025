              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.test('bd OK', () => pm.expect(pm.response.json().bd).to.eql('OK'));"
                ]
              }
            }
          ]
        }
      ]
    },
